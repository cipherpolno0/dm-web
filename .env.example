# Copy this file to .env.local for development. Never commit real values.
# Any value with a secret, password, token, key, or connection string belongs
# in the deployment platform's encrypted environment-variable store.

# -----------------------------------------------------------------------------
# Next.js public configuration (safe to expose to the browser)
# -----------------------------------------------------------------------------
# Canonical production origin; no trailing slash. This value is embedded at build time.
NEXT_PUBLIC_SITE_URL="https://exam.example.org"

# -----------------------------------------------------------------------------
# Application server and PostgreSQL (required in deployed environments)
# -----------------------------------------------------------------------------
# PostgreSQL connection string used only on the server and by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"
# Separate high-entropy secret for deterministic applicant-ID hashing.
APPLICANT_ID_HASH_SECRET=""

# Auth.js session signing secret. Generate a unique high-entropy value per environment.
AUTH_SECRET=""
# Set true only when deployed behind the trusted Vercel/reverse-proxy host.
AUTH_TRUST_HOST="false"
# Optional separate pepper for hashing the login source IP in audit logs.
AUTH_AUDIT_HASH_SECRET=""

# -----------------------------------------------------------------------------
# Private Supabase media storage (required only when file upload is enabled)
# -----------------------------------------------------------------------------
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# Bucket must be private; this name is not a secret.
SUPABASE_MEDIA_BUCKET="private-media"

# -----------------------------------------------------------------------------
# Inngest and email notifications (required only when notifications are enabled)
# -----------------------------------------------------------------------------
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
RESEND_API_KEY=""
# Verified sender address, for example: "results@exam.example.org"
RESULT_NOTIFICATION_FROM=""

# -----------------------------------------------------------------------------
# Test only — must point to a dedicated synthetic database whose name contains "test".
# Never point this at development, staging, or production.
# -----------------------------------------------------------------------------
E2E_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/dhammastudy_test?schema=public"

# -----------------------------------------------------------------------------
# GitHub Actions production environment secrets — do not put these in Vercel.
# PRODUCTION_DATABASE_URL must refer to the same production database as DATABASE_URL.
# -----------------------------------------------------------------------------
VERCEL_TOKEN=""
VERCEL_ORG_ID=""
VERCEL_PROJECT_ID=""
PRODUCTION_DATABASE_URL=""
