{
  "name": "dhammastudy-exam",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "pnpm test:all",
    "test:unit": "node --import tsx --test --experimental-test-coverage --test-coverage-include='lib/**/*.ts' tests/*.test.ts",
    "test:e2e": "tsx scripts/run-e2e-tests.ts",
    "test:all": "pnpm test:unit && pnpm test:e2e",
    "test:e2e:install": "playwright install --with-deps chromium",
    "audit:a11y": "tsx scripts/audit-a11y.ts",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint-staged": "lint-staged",
    "prisma:validate": "prisma validate",
    "precommit": "pnpm lint-staged && pnpm type-check",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@expo-google-fonts/sarabun": "0.4.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "^7.10.0",
    "@supabase/supabase-js": "2.49.1",
    "@tiptap/react": "2.11.5",
    "@tiptap/starter-kit": "2.11.5",
    "@types/pdfkit": "0.13.9",
    "bcryptjs": "3.0.3",
    "exceljs": "4.4.0",
    "file-type": "20.5.0",
    "inngest": "3.54.0",
    "next": "^16.3.6",
    "next-auth": "5.0.0-beta.30",
    "pdfkit": "0.17.2",
    "pg": "8.16.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "6.30.0",
    "sanitize-html": "2.16.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "2.16.0",
    "axe-core": "4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "husky": "^9.1.7",
    "lighthouse": "12.8.2",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "prisma": "7.10.0",
    "puppeteer": "24.14.0",
    "tailwindcss": "^4.3.3",
    "tsx": "4.20.6",
    "typescript": "^5.9.3"
  }
}
